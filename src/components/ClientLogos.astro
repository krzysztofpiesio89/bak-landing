---
export interface BrandLogo {
  id: string;
  name: string;
  src: string;
  alt: string;
  width: string;
}

const brands: BrandLogo[] = [
  {
    id: 'psp',
    name: 'PSP audioware',
    src: '/brands/psp-logo-light.svg',
    alt: 'PSP audioware logo',
    width: '115px',
  },
  {
    id: 'fabfilter',
    name: 'FabFilter',
    src: '/brands/logo-fabfilter-2022.svg',
    alt: 'FabFilter logo',
    width: '36px',
  },
  {
    id: 'audiospot',
    name: 'Audio Spot',
    src: '/brands/audiospotWhite_transs.webp',
    alt: 'Audio Spot logo',
    width: '105px',
  },
  {
    id: 'spl',
    name: 'SPL',
    src: '/brands/spl.png',
    alt: 'SPL logo',
    width: '54px',
  },
  {
    id: 'toneboosters',
    name: 'ToneBoosters',
    src: '/brands/toneboosters.png',
    alt: 'ToneBoosters logo',
    width: '120px',
  },
];
---

<div class="client-logos" aria-label="Logotypy partnerów i oprogramowania">
  <div class="client-logos__track">
    {brands.map((brand) => (
      <div class={`client-logos__item client-logos__item--${brand.id}`} data-brand={brand.id}>
        <img
          src={brand.src}
          alt={brand.alt}
          class={`client-logos__img client-logos__img--${brand.id}`}
          style={`width: ${brand.width};`}
          loading="eager"
          decoding="async"
        />
      </div>
    ))}
  </div>
</div>

<style>
  .client-logos {
    margin-top: var(--space-12);
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .client-logos__track {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(14px, 3vw, 42px);
    flex-wrap: nowrap; /* All 5 logos strictly in 1 single row */
    max-width: 100%;
  }

  .client-logos__item {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 52px;
    padding: 4px 6px;
    transition: transform 300ms ease, background 300ms ease, border-color 300ms ease;
    flex-shrink: 0;
  }

  .client-logos__item:hover {
    transform: translateY(-2px);
  }

  .client-logos__img {
    height: auto;
    object-fit: contain;
    transition: filter 300ms ease, opacity 300ms ease, transform 300ms ease;
    display: block;
  }

  /* 1. PSP Audioware (White SVG) */
  .client-logos__img--psp {
    width: 115px;
    filter: opacity(0.75);
  }
  .client-logos__item--psp:hover .client-logos__img--psp {
    filter: opacity(1);
  }

  /* 2. FabFilter (SVG) */
  .client-logos__img--fabfilter {
    width: 36px;
    filter: grayscale(100%) brightness(1.2) opacity(0.75);
    border-radius: 4px;
  }
  .client-logos__item--fabfilter:hover .client-logos__img--fabfilter {
    filter: grayscale(0%) brightness(1) opacity(1);
  }

  /* 3. Audio Spot (White WebP) */
  .client-logos__img--audiospot {
    width: 105px;
    filter: opacity(0.75);
  }
  .client-logos__item--audiospot:hover .client-logos__img--audiospot {
    filter: opacity(1);
  }

  /* 4. SPL (PNG Inverted Card) */
  .client-logos__item--spl {
    height: auto;
    padding: 0;
  }

  .client-logos__img--spl {
    width: 68px;
    border-radius: 8px;
    filter: invert(1) contrast(1.15) opacity(0.85);
  }
  .client-logos__item--spl:hover .client-logos__img--spl {
    filter: invert(1) contrast(1.15) opacity(1);
  }

  /* 5. ToneBoosters (PNG) */
  .client-logos__img--toneboosters {
    width: 120px;
    filter: brightness(0) invert(1) opacity(0.75);
  }
  .client-logos__item--toneboosters:hover .client-logos__img--toneboosters {
    filter: brightness(0) invert(1) opacity(1);
  }

  @media (max-width: 900px) {
    .client-logos__track {
      gap: 12px;
      flex-wrap: wrap;
    }
    .client-logos__img--psp { width: 95px; }
    .client-logos__img--fabfilter { width: 30px; }
    .client-logos__img--audiospot { width: 85px; }
    .client-logos__img--spl { width: 36px; }
    .client-logos__img--toneboosters { width: 100px; }
  }
</style>
