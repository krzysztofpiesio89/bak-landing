---
const sampleGroups = [
  {
    id: 'sample-1',
    num: '01',
    title: 'Dialogi z planu filmowego',
    beforeDuration: '01:04',
    afterDuration: '01:04',
    beforeSrc: '/audio/before1.mp3',
    afterSrc: '/audio/after1.mp3',
  },
  {
    id: 'sample-2',
    num: '02',
    title: 'Nagranie plenerowe (wiatr i szum)',
    beforeDuration: '00:48',
    afterDuration: '00:48',
    beforeSrc: '/audio/before2.mp3',
    afterSrc: '/audio/after2.mp3',
  },
  {
    id: 'sample-3',
    num: '03',
    title: 'Redukcja hałasu i przydźwięku',
    beforeDuration: '01:15',
    afterDuration: '01:15',
    beforeSrc: '/audio/before3.mp3',
    afterSrc: '/audio/after3.mp3',
  },
  {
    id: 'sample-4',
    num: '04',
    title: 'Finalny mix i mastering spotu',
    beforeDuration: '00:30',
    afterDuration: '00:30',
    beforeSrc: '/audio/before4.mp3',
    afterSrc: '/audio/after4.mp3',
  },
];
---

<section class="before-after section" id="przed-po" aria-label="Porównanie dźwięku przed i po">
  <div class="container">
    <!-- Header -->
    <div class="before-after__header" data-animate>
      <p class="section-label">Przed i po</p>
      <p class="before-after__subtitle">
        Posłuchaj transformacji trudnego, często niedoskonałego materiału z planu, do dźwięku który jest gotowy do profesjonalnej emisji. Usłysz różnicę między nagraniem z brudami, szumami czy niespójnym brzmieniem, a dźwiękiem po kompleksowej postprodukcji.
      </p>
    </div>

    <!-- Grid Layout -->
    <div class="ba-grid" data-animate data-animate-delay="200">
      <!-- Left: Sample Selection List -->
      <div class="ba-samples-list">
        {sampleGroups.map((sample, index) => (
          <button
            class={`ba-sample-btn ${index === 0 ? 'ba-sample-btn--active' : ''}`}
            data-sample-id={sample.id}
            data-index={index}
          >
            <span class="ba-sample-num">{sample.num}</span>
            <span class="ba-sample-title">{sample.title}</span>
          </button>
        ))}
      </div>

      <!-- Right: Audio Waveform Players (Przed & Po) -->
      <div class="ba-players-col">
        <!-- PRZED Player -->
        <div class="ba-row" id="player-row-before">
          <span class="ba-row-label">Przed</span>
          <div class="ba-player-box">
            <button class="ba-play-btn" id="btn-play-before" aria-label="Odtwórz dźwięk przed">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="5,3 19,12 5,21" />
              </svg>
            </button>
            <div class="ba-waveform" id="waveform-before">
              {Array.from({ length: 45 }).map((_, i) => (
                <span class="waveform-bar" style={`height: ${15 + (i % 7) * 8 + (i % 3) * 6}%`}></span>
              ))}
            </div>
            <span class="ba-duration" id="duration-before">01:04</span>
          </div>
        </div>

        <!-- PO Player -->
        <div class="ba-row" id="player-row-after">
          <span class="ba-row-label">Po</span>
          <div class="ba-player-box">
            <button class="ba-play-btn" id="btn-play-after" aria-label="Odtwórz dźwięk po">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="5,3 19,12 5,21" />
              </svg>
            </button>
            <div class="ba-waveform" id="waveform-after">
              {Array.from({ length: 45 }).map((_, i) => (
                <span class="waveform-bar" style={`height: ${20 + (i % 5) * 12 + (i % 4) * 8}%`}></span>
              ))}
            </div>
            <span class="ba-duration" id="duration-after">01:04</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .before-after {
    padding: var(--space-20) 0;
  }

  .before-after__header {
    max-width: 680px;
    margin-bottom: var(--space-12);
  }

  .section-badge {
    display: inline-block;
    width: 10px;
    height: 10px;
    background-color: var(--color-accent);
    margin-right: 8px;
    vertical-align: middle;
  }

  .section-label {
    display: flex;
    align-items: center;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-6);
  }

  .before-after__subtitle {
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Grid */
  .ba-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: var(--space-16);
    align-items: center;
  }

  /* Samples Stack */
  .ba-samples-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ba-sample-btn {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: transparent;
    color: var(--color-text);
    border-radius: 0;
    cursor: pointer;
    text-align: left;
    transition: all var(--transition-fast);
  }

  .ba-sample-btn:hover {
    border-color: var(--color-accent);
  }

  .ba-sample-btn--active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #000000;
    font-weight: 700;
  }

  .ba-sample-num {
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .ba-sample-title {
    font-size: var(--text-sm);
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Players Column */
  .ba-players-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .ba-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .ba-row-label {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-text-secondary);
    text-transform: none;
  }

  .ba-player-box {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    background: transparent;
  }

  .ba-play-btn {
    width: 44px;
    height: 44px;
    background: var(--color-accent);
    border: none;
    color: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .ba-play-btn:hover {
    transform: scale(1.05);
    box-shadow: 0 0 15px rgba(168, 255, 62, 0.4);
  }

  /* Waveform */
  .ba-waveform {
    display: flex;
    align-items: center;
    gap: 3px;
    flex: 1;
    height: 48px;
    padding: 4px 0;
  }

  .waveform-bar {
    flex: 1;
    background-color: var(--color-accent);
    border-radius: 1px;
    min-height: 4px;
    transition: height 0.2s ease;
    opacity: 0.85;
  }

  .ba-row:has(#waveform-before) .waveform-bar {
    opacity: 0.65;
  }

  .ba-duration {
    font-size: var(--text-xs);
    font-weight: 600;
    font-family: var(--font-mono, monospace);
    color: var(--color-text-secondary);
    flex-shrink: 0;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .ba-grid {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }
  }
</style>

<script define:vars={{ sampleGroups }}>
  const sampleBtns = document.querySelectorAll('.ba-sample-btn');
  const durBefore = document.getElementById('duration-before');
  const durAfter = document.getElementById('duration-after');
  const waveBefore = document.getElementById('waveform-before');
  const waveAfter = document.getElementById('waveform-after');

  let activeIndex = 0;
  let isPlayingBefore = false;
  let isPlayingAfter = false;

  sampleBtns.forEach((btn, idx) => {
    btn.addEventListener('click', () => {
      sampleBtns.forEach((b) => b.classList.remove('ba-sample-btn--active'));
      btn.classList.add('ba-sample-btn--active');
      activeIndex = idx;

      const sample = sampleGroups[activeIndex];
      if (durBefore) durBefore.textContent = sample.beforeDuration;
      if (durAfter) durAfter.textContent = sample.afterDuration;

      // Animate waveform bars on change
      animateWaveform(waveBefore);
      animateWaveform(waveAfter);
    });
  });

  function animateWaveform(container) {
    if (!container) return;
    const bars = container.querySelectorAll('.waveform-bar');
    bars.forEach((bar) => {
      const randomHeight = Math.floor(Math.random() * 80) + 15;
      (bar).style.height = `${randomHeight}%`;
    });
  }

  // Play button click animation / simulation
  const btnBefore = document.getElementById('btn-play-before');
  const btnAfter = document.getElementById('btn-play-after');

  btnBefore?.addEventListener('click', () => {
    isPlayingBefore = !isPlayingBefore;
    if (isPlayingBefore) {
      btnBefore.style.opacity = '0.7';
      const interval = setInterval(() => {
        if (!isPlayingBefore) clearInterval(interval);
        animateWaveform(waveBefore);
      }, 200);
    } else {
      btnBefore.style.opacity = '1';
    }
  });

  btnAfter?.addEventListener('click', () => {
    isPlayingAfter = !isPlayingAfter;
    if (isPlayingAfter) {
      btnAfter.style.opacity = '0.7';
      const interval = setInterval(() => {
        if (!isPlayingAfter) clearInterval(interval);
        animateWaveform(waveAfter);
      }, 200);
    } else {
      btnAfter.style.opacity = '1';
    }
  });
</script>
