---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<section class="about section" id="o-mnie" aria-label="O mnie">
  <div class="container about__inner">
    <!-- Text side -->
    <div class="about__text-col">
      <p class="section-label" data-animate>Kim jestem</p>

      <h2 class="about__heading" data-animate data-animate-delay="100">
        Jestem realizatorem dźwięku, który sprawia, że dźwięk pracuje dla Ciebie i staje się przewodnikiem; prowadzi widza przez kolejne momenty filmu
      </h2>

      <div class="about__body" data-animate data-animate-delay="200">
        <p>
          <span class="text-accent">Nazywam się Krzysztof Bąk.</span> Jestem absolwentem Wydziału Radia i Telewizji Uniwersytetu Śląskiego w Katowicach. Dźwięk towarzyszy mi przez całe moje życie zawodowe – od pierwszych lat pracy w Polskim Radiu aż po dzisiejsze projekty realizowane dla telewizji, kina, Internetu i przestrzeni multimedialnych.
        </p>
      </div>

      <!-- Slider arrows -->
      <div class="about__slider-arrows" data-animate data-animate-delay="300">
        <a href="#hero" class="slider-arrow slider-arrow--prev" aria-label="Poprzedni">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
        </a>
        <a href="#jak-pracuje" class="slider-arrow slider-arrow--next slider-arrow--active" aria-label="Przejdź do Jak pracuję">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Image side -->
    <div class="about__image-col" data-animate>
      <div class="about__image-frame">
        <img
          src={`${base}12%20kolor.png`}
          alt="Krzysztof Bąk — realizator dźwięku na planie"
          class="about__image"
          width="540"
          height="640"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    padding: var(--space-20) 0;
  }

  .about__inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-16);
    align-items: center;
  }

  .section-badge {
    display: inline-block;
    width: 10px;
    height: 10px;
    background-color: var(--color-accent);
    margin-right: 8px;
    vertical-align: middle;
  }

  .section-label {
    display: flex;
    align-items: center;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-6);
    text-transform: none;
    letter-spacing: 0;
  }

  /* Image column */
  .about__image-frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-sm);
  }

  .about__image {
    width: 100%;
    height: auto;
    object-fit: cover;
    aspect-ratio: 4/3;
    filter: grayscale(100%);
    transition: filter var(--transition-slow);
    display: block;
  }

  .about__image-frame:hover .about__image {
    filter: grayscale(0%);
  }

  /* Text column */
  .about__heading {
    font-family: 'Inter', var(--font-sans);
    font-weight: 400;
    font-style: normal;
    font-size: 16px;
    line-height: 135%;
    letter-spacing: -0.01em;
    color: #FDFDFD;
    margin-bottom: var(--space-6);
  }

  .about__body p {
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-8);
  }

  /* Slider arrows */
  .about__slider-arrows {
    display: flex;
    gap: 12px;
  }

  .slider-arrow {
    width: 48px;
    height: 48px;
    border-radius: 0;
    border: 1px solid rgba(168, 255, 62, 0.3);
    background: transparent;
    color: rgba(168, 255, 62, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--transition-fast);
    text-decoration: none;
  }

  .slider-arrow--active,
  .slider-arrow:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    box-shadow: 0 0 12px rgba(168, 255, 62, 0.2);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .about__inner {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }
    .about__image-col {
      order: -1;
    }
  }
</style>
