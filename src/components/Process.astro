---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const steps = [
  {
    number: 1,
    title: 'Przyjęcie i analiza materiału',
    body: 'Każdy projekt startuje z chwilą gdy materiał trafia do mnie, zwykle w postaci surowych ścieżek dźwiękowych z planu filmowego lub z montażu obrazu. To moment, w którym zaczynam pracę nad tym, żeby dźwięk nabrał jakości, spójności i finalnie brzmiał profesjonalnie – tak, aby bez problemu mógł trafić do emisji w kinie, telewizji czy Internecie',
    image: '15 kolor.png',
  },
  {
    number: 2,
    title: 'Czyszczenie i montaż dialogów',
    body: 'Materiał z planu zdarza się, że nie jest idealny – i to zupełnie normalne. Plan filmowy to żywe środowisko, gdzie nie wszystko można kontrolować. Usuwanie szumów i zakłóceń, redukcja pogłosów, eliminacja ocierek mikrofonów o ubrania, dopasowanie dźwięków z różnych dubli… To techniczne zabiegi, które wykonuję po to, by widz mógł skupić się wyłącznie na historii',
    image: '16 kolor.png',
  },
  {
    number: 3,
    title: 'Budowanie przestrzeni dźwiękowej',
    body: 'Dopasowanie atmosfer i tła scen, integracja efektów dźwiękowych, wyrównanie dynamiki między scenami, przygotowanie materiału do finalnego mixu. Jeśli projekt wymaga sound designu lub kreatywnej warstwy dźwiękowej, pojawia się dodatkowy etap pracy koncepcyjnej. To moment, w którym dźwięk przestaje być tylko techniką, a staje się częścią narracji filmu',
    image: '17 kolor.png',
  },
  {
    number: 4,
    title: 'Finalny mix',
    body: 'W zależności od przeznaczenia projektu przygotowuję mix stereo, 5.1 surround lub inne konfiguracje wymagane przez system emisji. Dbam, aby mix był zgodny z obowiązującymi standardami emisyjnymi, tak aby gotowy materiał spełniał wymagania techniczne stawiane przez nadawców',
    image: '18 kolor.png',
  },
  {
    number: 5,
    title: 'Materiał gotowy do emisji',
    body: 'Otrzymujesz ode mnie kompletny zestaw plików – finalny mix, wersje emisyjne zgodne ze standardami, ewentualne STEM’y – dialogi, muzykę, efekty. W tym momencie dźwięk jest już w pełni profesjonalny, spójny i gotowy do publikacji. Każdy projekt jest trochę inny – ale cel pozostaje ten sam: sprawić, by Twoja historia zabrzmiała dokładnie tak, jak powinna',
    image: '19 kolor.png',
  },
];
---

<section class="process section" id="jak-pracuje" aria-label="Jak pracuję — proces">
  <div class="container process__inner">
    <!-- Image -->
    <div class="process__image-col" data-animate>
      <div class="process__image-frame">
        {steps.map((step, idx) => (
          <img
            id={`process-img-${idx + 1}`}
            src={`${base}${step.image}`}
            alt={`Krzysztof Bąk — ${step.title}`}
            class={`process__image ${idx === 0 ? 'process__image--active' : ''}`}
            data-process-img={idx + 1}
            width="540"
            height="640"
            loading="lazy"
            decoding="async"
          />
        ))}
      </div>
    </div>

    <!-- Process Content -->
    <div class="process__text-col" data-animate>
      <h2 class="section-label">Jak pracuję</h2>

      <!-- Step Card (background: #181919) -->
      <div class="process__card" id="process-card">
        <div class="process__card-header">
          <h3 class="process__card-title" id="process-title">{steps[0].title}</h3>
          <span class="process__step-badge" id="process-badge">{steps[0].number}</span>
        </div>
        <p class="process__card-body" id="process-body">{steps[0].body}</p>
      </div>

      <!-- Navigation Arrows -->
      <div class="process__slider-arrows">
        <button class="slider-arrow" id="process-prev-btn" aria-label="Poprzedni etap">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
        </button>
        <button class="slider-arrow slider-arrow--active" id="process-next-btn" aria-label="Następny etap">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .process {
    padding: var(--space-20) 0;
  }

  .process__inner {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: var(--space-16);
    align-items: center;
  }

  .section-label {
    display: flex;
    align-items: center;
    font-family: 'Neue Haas Grotesk Text Pro', 'Inter', sans-serif;
    font-weight: 500;
    font-size: 24px;
    line-height: 120%;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin-bottom: var(--space-6);
    text-transform: none;
  }

  .section-label::before {
    content: '';
    display: inline-block;
    width: 10px;
    height: 10px;
    background-color: var(--color-accent);
    margin-right: 12px;
  }

  /* Image */
  .process__image-frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-sm);
    aspect-ratio: 4/3;
  }

  .process__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 350ms ease, filter var(--transition-slow);
    display: block;
  }

  .process__image.process__image--active {
    opacity: 1 !important;
    pointer-events: auto !important;
  }

  .process__image-frame:hover .process__image {
    filter: grayscale(0%);
  }

  /* Card (background: #181919) */
  .process__card {
    background-color: #181919;
    border: none;
    padding: 32px;
    border-radius: 0;
    margin-bottom: var(--space-6);
    min-height: 240px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .process__card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .process__card-title {
    font-family: 'Neue Haas Grotesk Text Pro', 'Inter', sans-serif;
    font-weight: 500;
    font-size: 21px;
    line-height: 120%;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin: 0;
  }

  .process__step-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text-secondary);
    flex-shrink: 0;
  }

  .process__card-body {
    font-family: 'Neue Haas Grotesk Text Pro', 'Inter', sans-serif;
    font-weight: 400;
    font-style: normal;
    font-size: 16px;
    line-height: 135%;
    letter-spacing: -0.01em;
    color: #e5e5e5;
    margin: 0;
  }

  /* Slider arrows */
  .process__slider-arrows {
    display: flex;
    gap: 12px;
  }

  .slider-arrow {
    width: 48px;
    height: 48px;
    border-radius: 0;
    border: 1px solid rgba(57, 255, 20, 0.3);
    background: transparent;
    color: rgba(57, 255, 20, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .slider-arrow--active,
  .slider-arrow:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    box-shadow: 0 0 12px rgba(57, 255, 20, 0.25);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .process__inner {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }
  }
</style>

<script define:vars={{ steps, base }}>
  let currentIndex = 0;

  function initProcessSlider() {
    const titleEl = document.getElementById('process-title');
    const badgeEl = document.getElementById('process-badge');
    const bodyEl = document.getElementById('process-body');
    const images = document.querySelectorAll('[data-process-img]');
    const prevBtn = document.getElementById('process-prev-btn');
    const nextBtn = document.getElementById('process-next-btn');

    if (!images.length) return;

    function updateStep(index) {
      currentIndex = index;
      if (titleEl) titleEl.textContent = steps[currentIndex].title;
      if (badgeEl) badgeEl.textContent = steps[currentIndex].number;
      if (bodyEl) bodyEl.textContent = steps[currentIndex].body;

      images.forEach((img) => {
        const imgNum = parseInt(img.getAttribute('data-process-img') || '1', 10);
        if (imgNum === currentIndex + 1) {
          img.classList.add('process__image--active');
          img.style.opacity = '1';
          img.style.pointerEvents = 'auto';
        } else {
          img.classList.remove('process__image--active');
          img.style.opacity = '0';
          img.style.pointerEvents = 'none';
        }
      });
    }

    prevBtn?.addEventListener('click', () => {
      let prev = currentIndex - 1;
      if (prev < 0) prev = steps.length - 1;
      updateStep(prev);
    });

    nextBtn?.addEventListener('click', () => {
      let next = currentIndex + 1;
      if (next >= steps.length) next = 0;
      updateStep(next);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProcessSlider);
  } else {
    initProcessSlider();
  }
</script>
