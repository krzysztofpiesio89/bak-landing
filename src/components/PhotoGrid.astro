---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const allPhotos = [
  // Col 1
  { id: 0, src: `${base}12%20kolor.png`, alt: 'Realizacja dźwięku filmowego na planie' },
  { id: 1, src: `${base}13%20kolor.png`, alt: 'Profesjonalny sprzęt nagraniowy Zaxcom' },
  { id: 2, src: `${base}14%20kolor.png`, alt: 'Praca lektorska i realizacja mikrofonowa' },
  // Col 2
  { id: 3, src: `${base}15%20kolor.png`, alt: 'Sprzęt audio i torby realizatorskie Orca' },
  { id: 4, src: `${base}16%20kolor.png`, alt: 'Rejestrator dźwięku Nagra i odsłuchy' },
  { id: 5, src: `${base}17%20kolor.png`, alt: 'Praca na planie z ekipą filmową' },
  // Col 3
  { id: 6, src: `${base}18%20kolor.png`, alt: 'Mikrofony kierunkowe i osłony przeciwwiatrowe' },
  { id: 7, src: `${base}19%20kolor.png`, alt: 'Portfolio nagrań plenerowych' },
  { id: 8, src: `${base}20%20kolor.png`, alt: 'Zestaw odbiorników bezprzewodowych Wisycom' },
];

const col1 = allPhotos.slice(0, 3);
const col2 = allPhotos.slice(3, 6);
const col3 = allPhotos.slice(6, 9);
---

<section class="plugin-grid" id="portfolio" aria-label="Portfolio fotograficzne">
  <div class="plugin-grid__wrapper">
    <!-- Col 1 -->
    <div class="plugin-grid__col side-col">
      {col1.map((photo) => (
        <div class="plugin-grid__item" data-lightbox-index={photo.id} role="button" aria-label={`Powiększ zdjęcie: ${photo.alt}`}>
          <img src={photo.src} alt={photo.alt} class="plugin-grid__img" loading="lazy" decoding="async" />
        </div>
      ))}
    </div>

    <!-- Col 2 -->
    <div class="plugin-grid__col center-col">
      {col2.map((photo) => (
        <div class="plugin-grid__item" data-lightbox-index={photo.id} role="button" aria-label={`Powiększ zdjęcie: ${photo.alt}`}>
          <img src={photo.src} alt={photo.alt} class="plugin-grid__img" loading="lazy" decoding="async" />
        </div>
      ))}
    </div>

    <!-- Col 3 -->
    <div class="plugin-grid__col side-col">
      {col3.map((photo) => (
        <div class="plugin-grid__item" data-lightbox-index={photo.id} role="button" aria-label={`Powiększ zdjęcie: ${photo.alt}`}>
          <img src={photo.src} alt={photo.alt} class="plugin-grid__img" loading="lazy" decoding="async" />
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Fullscreen Lightbox Modal -->
<div id="lightbox-modal" class="lightbox" aria-hidden="true" role="dialog" aria-label="Pełnoekranowa galeria zdjęć">
  <div class="lightbox__backdrop" id="lightbox-backdrop"></div>
  
  <button id="lightbox-close" class="lightbox__btn lightbox__btn--close" aria-label="Zamknij galerię">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>

  <button id="lightbox-prev" class="lightbox__btn lightbox__btn--prev" aria-label="Poprzednie zdjęcie">
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="15 18 9 12 15 6"></polyline>
    </svg>
  </button>

  <!-- Audio Wave Line Beam & Equalizer Bars (Connecting Left Arrow to Right Arrow) -->
  <div id="lightbox-soundwave" class="lightbox__soundwave" aria-hidden="true">
    <svg class="lightbox__soundwave-svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
      <path class="wave-line wave-line-1" d="M0,60 Q300,-10 600,60 T1200,60"></path>
      <path class="wave-line wave-line-2" d="M0,60 Q300,130 600,60 T1200,60"></path>
      <path class="wave-line wave-line-3" d="M0,60 Q200,20 400,60 T800,60 T1200,60"></path>
    </svg>
    <div class="lightbox__equalizer">
      <span class="eq-bar"></span>
      <span class="eq-bar"></span>
      <span class="eq-bar"></span>
      <span class="eq-bar"></span>
      <span class="eq-bar"></span>
      <span class="eq-bar"></span>
      <span class="eq-bar"></span>
    </div>
  </div>

  <div class="lightbox__content">
    <img id="lightbox-img" src="" alt="" class="lightbox__img" />
    <div class="lightbox__caption-bar">
      <span id="lightbox-caption" class="lightbox__caption"></span>
      <span id="lightbox-counter" class="lightbox__counter"></span>
    </div>
  </div>

  <button id="lightbox-next" class="lightbox__btn lightbox__btn--next" aria-label="Następne zdjęcie">
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="9 18 15 12 9 6"></polyline>
    </svg>
  </button>
</div>

<style>
  .plugin-grid {
    width: 100%;
    display: flex;
    justify-content: center;
    background: transparent;
    margin: 120px 0;
  }

  .plugin-grid__wrapper {
    width: 100%;
    max-width: 1440px;
    height: 774px;
    padding-left: 120px;
    padding-right: 120px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    align-items: center;
    margin: 0 auto;
  }

  .plugin-grid__col {
    display: grid;
    grid-template-rows: repeat(3, minmax(0, 1fr));
    gap: 12px;
    min-width: 0;
    min-height: 0;
  }

  .side-col {
    height: 80%;
  }

  .center-col {
    height: 100%;
  }

  /* Card Container with Hover Animation */
  .plugin-grid__item {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 0;
    overflow: hidden;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.08);
    cursor: pointer;
    background: #111;
    transition: border-color 300ms ease, box-shadow 300ms ease, transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .plugin-grid__item:hover {
    border-color: var(--color-accent);
    box-shadow: 0 0 30px rgba(57, 255, 20, 0.3);
    transform: translateY(-3px);
  }

  .plugin-grid__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: filter 450ms ease, transform 450ms cubic-bezier(0.16, 1, 0.3, 1);
    display: block;
  }

  .plugin-grid__item:hover .plugin-grid__img {
    filter: grayscale(0%);
    transform: scale(1.08);
  }

  /* Hover Overlay Badge */
  .plugin-grid__overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.6) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 300ms ease;
    pointer-events: none;
  }

  .plugin-grid__item:hover .plugin-grid__overlay {
    opacity: 1;
  }

  .plugin-grid__expand-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(10, 10, 10, 0.85);
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 20px rgba(57, 255, 20, 0.4);
    transform: scale(0.8);
    transition: transform 300ms cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .plugin-grid__item:hover .plugin-grid__expand-icon {
    transform: scale(1);
  }

  /* Fullscreen Lightbox Modal */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms ease;
  }

  .lightbox.lightbox--active {
    opacity: 1;
    pointer-events: auto;
  }

  .lightbox__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.93);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .lightbox__content {
    position: relative;
    z-index: 15; /* Higher than wave beam (5) so wave is hidden behind photo */
    max-width: 90vw;
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .lightbox__img {
    max-width: 90vw;
    max-height: 80vh;
    object-fit: contain;
    border-radius: var(--radius-sm);
    box-shadow: 0 0 40px rgba(0, 0, 0, 0.9), 0 0 25px rgba(57, 255, 20, 0.15);
    transition: filter 350ms cubic-bezier(0.2, 0.8, 0.2, 1),
                transform 350ms cubic-bezier(0.2, 0.8, 0.2, 1),
                opacity 350ms cubic-bezier(0.2, 0.8, 0.2, 1),
                box-shadow 350ms ease;
    will-change: filter, transform, opacity;
  }

  /* Smoke & Soundwave Dissolve Out State */
  .lightbox__img--smoke-out {
    opacity: 0.1;
    filter: blur(24px) grayscale(100%) contrast(1.4);
    transform: scale(0.93);
    box-shadow: 0 0 60px rgba(57, 255, 20, 0.6);
  }

  /* Smoke & Soundwave Dissolve In State */
  .lightbox__img--smoke-in {
    opacity: 0;
    filter: blur(20px) grayscale(70%) scale(1.06);
    box-shadow: 0 0 45px rgba(57, 255, 20, 0.45);
  }

  .lightbox.lightbox--active .lightbox__img {
    transform: scale(1);
  }

  /* Audio Impulse Beam Container (z-index 5, lower than photo so it passes behind the photo) */
  .lightbox__soundwave {
    position: fixed;
    top: 50%;
    left: 0;
    width: 100vw;
    height: 180px;
    transform: translateY(-50%);
    z-index: 5; /* Lower than photo (15) so wave is visible only on the sides */
    pointer-events: none;
    background: transparent; /* Absolutely no background shading */
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 120ms ease;
  }

  .lightbox__soundwave.active {
    opacity: 1;
  }

  .lightbox__soundwave-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100%;
    background: transparent;
  }

  .wave-line {
    fill: none;
    stroke: #39FF14;
    stroke-width: 0.6px;
    stroke-linecap: round;
    filter: drop-shadow(0 0 2px rgba(57, 255, 20, 0.6));
    stroke-dasharray: 1200;
    stroke-dashoffset: 1200;
  }

  /* Ethereal whisper-light acoustic wave lines */
  .lightbox__soundwave.active .wave-line-1 {
    animation: impulse-sweep 340ms cubic-bezier(0.1, 0.9, 0.2, 1) forwards;
    stroke-width: 0.6px;
    opacity: 0.75;
  }
  .lightbox__soundwave.active .wave-line-2 {
    animation: impulse-sweep 340ms cubic-bezier(0.1, 0.9, 0.2, 1) 30ms forwards;
    stroke-width: 0.4px;
    opacity: 0.45;
  }
  .lightbox__soundwave.active .wave-line-3 {
    animation: impulse-sweep 340ms cubic-bezier(0.1, 0.9, 0.2, 1) 60ms forwards;
    stroke-width: 0.25px;
    opacity: 0.25;
  }

  /* Ultra-sleek 1.5px Equalizer Audio Level Bars (Unchanged & Visible) */
  .lightbox__equalizer {
    position: absolute;
    bottom: 24px;
    z-index: 25; /* Higher than photo and wave overlay */
    display: flex;
    align-items: flex-end;
    gap: 4px;
    height: 24px;
    background: transparent;
    pointer-events: none;
  }

  .eq-bar {
    width: 1.5px;
    height: 100%;
    background: #39FF14;
    border-radius: 1px;
    box-shadow: 0 0 4px rgba(57, 255, 20, 0.7);
    opacity: 0.75;
    transform: scaleY(0.2);
    transform-origin: bottom;
  }

  .lightbox__soundwave.active .eq-bar:nth-child(1) { animation: eq-anim 280ms ease-in-out infinite alternate; }
  .lightbox__soundwave.active .eq-bar:nth-child(2) { animation: eq-anim 280ms ease-in-out 40ms infinite alternate; }
  .lightbox__soundwave.active .eq-bar:nth-child(3) { animation: eq-anim 280ms ease-in-out 80ms infinite alternate; }
  .lightbox__soundwave.active .eq-bar:nth-child(4) { animation: eq-anim 280ms ease-in-out 30ms infinite alternate; }
  .lightbox__soundwave.active .eq-bar:nth-child(5) { animation: eq-anim 280ms ease-in-out 120ms infinite alternate; }
  .lightbox__soundwave.active .eq-bar:nth-child(6) { animation: eq-anim 280ms ease-in-out 60ms infinite alternate; }
  .lightbox__soundwave.active .eq-bar:nth-child(7) { animation: eq-anim 280ms ease-in-out 100ms infinite alternate; }

  @keyframes eq-anim {
    0% { transform: scaleY(0.2); }
    100% { transform: scaleY(1); }
  }

  @keyframes impulse-sweep {
    0% {
      stroke-dashoffset: 1200;
      opacity: 0;
    }
    20% {
      opacity: 1;
    }
    100% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }

  @keyframes wave-draw {
    to { stroke-dashoffset: 0; }
  }

  @keyframes wave-pulse {
    0% { transform: translateY(-50%) scaleY(0.8); }
    100% { transform: translateY(-50%) scaleY(1.3); }
  }

  @keyframes eq-anim {
    0% { transform: scaleY(0.25); }
    100% { transform: scaleY(1); }
  }

  .lightbox__caption-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    max-width: 900px;
    padding: var(--space-2) var(--space-4);
    background: rgba(20, 20, 20, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-sm);
  }

  .lightbox__caption {
    font-size: var(--text-sm);
    color: var(--color-text);
    font-weight: 500;
  }

  .lightbox__counter {
    font-size: var(--text-xs);
    color: var(--color-accent);
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  /* Navigation & Close Buttons */
  .lightbox__btn {
    position: absolute;
    z-index: 20;
    width: 56px;
    height: 56px;
    border-radius: 0;
    border: 1px solid rgba(57, 255, 20, 0.4);
    background: rgba(10, 10, 10, 0.8);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .lightbox__btn:hover {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: #000;
    box-shadow: 0 0 20px rgba(57, 255, 20, 0.5);
  }

  .lightbox__btn--close {
    top: var(--space-6);
    right: var(--space-6);
  }

  .lightbox__btn--prev {
    left: var(--space-6);
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox__btn--next {
    right: var(--space-6);
    top: 50%;
    transform: translateY(-50%);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .plugin-grid {
      margin: 60px 0;
    }
    .plugin-grid__wrapper {
      padding-left: var(--space-6);
      padding-right: var(--space-6);
    }
  }

  @media (max-width: 768px) {
    .plugin-grid {
      margin: 40px 0;
    }
    .plugin-grid__wrapper {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      height: auto;
      gap: 12px;
      padding-left: 16px;
      padding-right: 16px;
    }
    .plugin-grid__col {
      display: contents;
    }
    .side-col,
    .center-col {
      height: auto;
    }
    .plugin-grid__item {
      height: auto;
      aspect-ratio: 4 / 3;
    }
    .lightbox__btn--prev {
      left: var(--space-2);
    }
    .lightbox__btn--next {
      right: var(--space-2);
    }
    .lightbox__btn--close {
      top: var(--space-2);
      right: var(--space-2);
    }
  }

  @media (max-width: 480px) {
    .plugin-grid__wrapper {
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
      padding-left: 12px;
      padding-right: 12px;
    }
    .plugin-grid__item {
      aspect-ratio: 1 / 1;
    }
  }
</style>

<script>
  const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

  const photos = [
    { id: 0, src: `${base}12%20kolor.png`, alt: 'Realizacja dźwięku filmowego na planie' },
    { id: 1, src: `${base}13%20kolor.png`, alt: 'Profesjonalny sprzęt nagraniowy Zaxcom' },
    { id: 2, src: `${base}14%20kolor.png`, alt: 'Praca lektorska i realizacja mikrofonowa' },
    { id: 3, src: `${base}15%20kolor.png`, alt: 'Sprzęt audio i torby realizatorskie Orca' },
    { id: 4, src: `${base}16%20kolor.png`, alt: 'Rejestrator dźwięku Nagra i odsłuchy' },
    { id: 5, src: `${base}17%20kolor.png`, alt: 'Praca na planie z ekipą filmową' },
    { id: 6, src: `${base}18%20kolor.png`, alt: 'Mikrofony kierunkowe i osłony przeciwwiatrowe' },
    { id: 7, src: `${base}19%20kolor.png`, alt: 'Portfolio nagrań plenerowych' },
    { id: 8, src: `${base}20%20kolor.png`, alt: 'Zestaw odbiorników bezprzewodowych Wisycom' },
  ];

  let currentIndex = 0;
  let isTransitioning = false;

  const modal = document.getElementById('lightbox-modal');
  const modalImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const modalCaption = document.getElementById('lightbox-caption');
  const modalCounter = document.getElementById('lightbox-counter');
  const backdrop = document.getElementById('lightbox-backdrop');
  const closeBtn = document.getElementById('lightbox-close');
  const prevBtn = document.getElementById('lightbox-prev');
  const nextBtn = document.getElementById('lightbox-next');

  function openLightbox(index: number) {
    currentIndex = index;
    updateLightboxDirect();
    modal?.classList.add('lightbox--active');
    modal?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    modal?.classList.remove('lightbox--active');
    modal?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  function updateLightboxDirect() {
    const photo = photos[currentIndex];
    if (modalImg && photo) {
      modalImg.src = photo.src;
      modalImg.alt = photo.alt;
    }
    if (modalCaption && photo) {
      modalCaption.textContent = photo.alt;
    }
    if (modalCounter) {
      modalCounter.textContent = `${currentIndex + 1} / ${photos.length}`;
    }
  }

  const soundwaveOverlay = document.getElementById('lightbox-soundwave');

  function changePhotoWithSmokeTransition(newIndex: number) {
    if (isTransitioning || newIndex === currentIndex || !modalImg) return;
    isTransitioning = true;

    // Step 1: Trigger Soundwave Waveform Animation & Smoke Out
    soundwaveOverlay?.classList.add('active');
    modalImg.classList.add('lightbox__img--smoke-out');

    setTimeout(() => {
      currentIndex = newIndex;
      const photo = photos[currentIndex];
      modalImg.src = photo.src;
      modalImg.alt = photo.alt;

      if (modalCaption && photo) modalCaption.textContent = photo.alt;
      if (modalCounter) modalCounter.textContent = `${currentIndex + 1} / ${photos.length}`;

      // Step 2: Switch to Smoke In state
      modalImg.classList.remove('lightbox__img--smoke-out');
      modalImg.classList.add('lightbox__img--smoke-in');

      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          // Step 3: Dissolve Smoke & Hide Waveform Overlay
          modalImg.classList.remove('lightbox__img--smoke-in');
          setTimeout(() => {
            soundwaveOverlay?.classList.remove('active');
            isTransitioning = false;
          }, 350);
        });
      });
    }, 220);
  }

  function showNext() {
    const nextIdx = (currentIndex + 1) % photos.length;
    changePhotoWithSmokeTransition(nextIdx);
  }

  function showPrev() {
    const prevIdx = (currentIndex - 1 + photos.length) % photos.length;
    changePhotoWithSmokeTransition(prevIdx);
  }

  // Event Listeners
  document.querySelectorAll('.plugin-grid__item').forEach((item) => {
    item.addEventListener('click', () => {
      const indexAttr = item.getAttribute('data-lightbox-index');
      if (indexAttr !== null) {
        openLightbox(parseInt(indexAttr, 10));
      }
    });
  });

  closeBtn?.addEventListener('click', closeLightbox);
  backdrop?.addEventListener('click', closeLightbox);
  prevBtn?.addEventListener('click', showPrev);
  nextBtn?.addEventListener('click', showNext);

  document.addEventListener('keydown', (e) => {
    if (!modal?.classList.contains('lightbox--active')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowRight') showNext();
    if (e.key === 'ArrowLeft') showPrev();
  });
</script>
