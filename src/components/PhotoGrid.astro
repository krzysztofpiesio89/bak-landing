---
const allPhotos = [
  // Col 1
  { id: 0, src: '/12 kolor.png', alt: 'Realizacja dźwięku filmowego na planie' },
  { id: 1, src: '/13 kolor.png', alt: 'Profesjonalny sprzęt nagraniowy Zaxcom' },
  { id: 2, src: '/14 kolor.png', alt: 'Praca lektorska i realizacja mikrofonowa' },
  // Col 2
  { id: 3, src: '/15 kolor.png', alt: 'Sprzęt audio i torby realizatorskie Orca' },
  { id: 4, src: '/16 kolor.png', alt: 'Rejestrator dźwięku Nagra i odsłuchy' },
  { id: 5, src: '/17 kolor.png', alt: 'Praca na planie z ekipą filmową' },
  // Col 3
  { id: 6, src: '/18 kolor.png', alt: 'Mikrofony kierunkowe i osłony przeciwwiatrowe' },
  { id: 7, src: '/19 kolor.png', alt: 'Portfolio nagrań plenerowych' },
  { id: 8, src: '/20 kolor.png', alt: 'Zestaw odbiorników bezprzewodowych Wisycom' },
];

const col1 = allPhotos.slice(0, 3);
const col2 = allPhotos.slice(3, 6);
const col3 = allPhotos.slice(6, 9);
---

<section class="plugin-grid" id="portfolio" aria-label="Portfolio fotograficzne">
  <div class="plugin-grid__wrapper">
    <!-- Col 1 -->
    <div class="plugin-grid__col side-col">
      {col1.map((photo) => (
        <div class="plugin-grid__item" data-lightbox-index={photo.id} role="button" aria-label={`Powiększ zdjęcie: ${photo.alt}`}>
          <img src={photo.src} alt={photo.alt} class="plugin-grid__img" loading="lazy" decoding="async" />
        </div>
      ))}
    </div>

    <!-- Col 2 -->
    <div class="plugin-grid__col center-col">
      {col2.map((photo) => (
        <div class="plugin-grid__item" data-lightbox-index={photo.id} role="button" aria-label={`Powiększ zdjęcie: ${photo.alt}`}>
          <img src={photo.src} alt={photo.alt} class="plugin-grid__img" loading="lazy" decoding="async" />
        </div>
      ))}
    </div>

    <!-- Col 3 -->
    <div class="plugin-grid__col side-col">
      {col3.map((photo) => (
        <div class="plugin-grid__item" data-lightbox-index={photo.id} role="button" aria-label={`Powiększ zdjęcie: ${photo.alt}`}>
          <img src={photo.src} alt={photo.alt} class="plugin-grid__img" loading="lazy" decoding="async" />
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Fullscreen Lightbox Modal -->
<div id="lightbox-modal" class="lightbox" aria-hidden="true" role="dialog" aria-label="Pełnoekranowa galeria zdjęć">
  <div class="lightbox__backdrop" id="lightbox-backdrop"></div>
  
  <button id="lightbox-close" class="lightbox__btn lightbox__btn--close" aria-label="Zamknij galerię">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>

  <button id="lightbox-prev" class="lightbox__btn lightbox__btn--prev" aria-label="Poprzednie zdjęcie">
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="15 18 9 12 15 6"></polyline>
    </svg>
  </button>

  <div class="lightbox__content">
    <img id="lightbox-img" src="" alt="" class="lightbox__img" />
    <div class="lightbox__caption-bar">
      <span id="lightbox-caption" class="lightbox__caption"></span>
      <span id="lightbox-counter" class="lightbox__counter"></span>
    </div>
  </div>

  <button id="lightbox-next" class="lightbox__btn lightbox__btn--next" aria-label="Następne zdjęcie">
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="9 18 15 12 9 6"></polyline>
    </svg>
  </button>
</div>

<style>
  .plugin-grid {
    width: 100%;
    display: flex;
    justify-content: center;
    background: transparent;
    margin: 120px 0;
  }

  .plugin-grid__wrapper {
    width: 100%;
    max-width: 1440px;
    height: 774px;
    padding-left: 120px;
    padding-right: 120px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    align-items: center;
    margin: 0 auto;
  }

  .plugin-grid__col {
    display: grid;
    grid-template-rows: repeat(3, minmax(0, 1fr));
    gap: 12px;
    min-width: 0;
    min-height: 0;
  }

  .side-col {
    height: 80%;
  }

  .center-col {
    height: 100%;
  }

  /* Card Container with Hover Animation */
  .plugin-grid__item {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 0;
    overflow: hidden;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.08);
    cursor: pointer;
    background: #111;
    transition: border-color 300ms ease, box-shadow 300ms ease, transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .plugin-grid__item:hover {
    border-color: var(--color-accent);
    box-shadow: 0 0 30px rgba(57, 255, 20, 0.3);
    transform: translateY(-3px);
  }

  .plugin-grid__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: filter 450ms ease, transform 450ms cubic-bezier(0.16, 1, 0.3, 1);
    display: block;
  }

  .plugin-grid__item:hover .plugin-grid__img {
    filter: grayscale(0%);
    transform: scale(1.08);
  }

  /* Hover Overlay Badge */
  .plugin-grid__overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.6) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 300ms ease;
    pointer-events: none;
  }

  .plugin-grid__item:hover .plugin-grid__overlay {
    opacity: 1;
  }

  .plugin-grid__expand-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(10, 10, 10, 0.85);
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 20px rgba(57, 255, 20, 0.4);
    transform: scale(0.8);
    transition: transform 300ms cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .plugin-grid__item:hover .plugin-grid__expand-icon {
    transform: scale(1);
  }

  /* Fullscreen Lightbox Modal */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms ease;
  }

  .lightbox.lightbox--active {
    opacity: 1;
    pointer-events: auto;
  }

  .lightbox__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.93);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .lightbox__content {
    position: relative;
    z-index: 10;
    max-width: 90vw;
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .lightbox__img {
    max-width: 90vw;
    max-height: 75vh;
    object-fit: contain;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.9);
    transform: scale(0.95);
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lightbox.lightbox--active .lightbox__img {
    transform: scale(1);
  }

  .lightbox__caption-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    max-width: 900px;
    padding: var(--space-2) var(--space-4);
    background: rgba(20, 20, 20, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-sm);
  }

  .lightbox__caption {
    font-size: var(--text-sm);
    color: var(--color-text);
    font-weight: 500;
  }

  .lightbox__counter {
    font-size: var(--text-xs);
    color: var(--color-accent);
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  /* Navigation & Close Buttons */
  .lightbox__btn {
    position: absolute;
    z-index: 20;
    width: 56px;
    height: 56px;
    border-radius: 0;
    border: 1px solid rgba(57, 255, 20, 0.4);
    background: rgba(10, 10, 10, 0.8);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .lightbox__btn:hover {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: #000;
    box-shadow: 0 0 20px rgba(57, 255, 20, 0.5);
  }

  .lightbox__btn--close {
    top: var(--space-6);
    right: var(--space-6);
  }

  .lightbox__btn--prev {
    left: var(--space-6);
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox__btn--next {
    right: var(--space-6);
    top: 50%;
    transform: translateY(-50%);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .plugin-grid {
      margin: 60px 0;
    }
    .plugin-grid__wrapper {
      padding-left: var(--space-6);
      padding-right: var(--space-6);
    }
  }

  @media (max-width: 768px) {
    .plugin-grid {
      margin: 40px 0;
    }
    .plugin-grid__wrapper {
      display: flex;
      flex-direction: column;
      height: auto;
      gap: 12px;
      padding-left: var(--space-4);
      padding-right: var(--space-4);
    }
    .plugin-grid__col {
      display: flex;
      flex-direction: column;
      height: auto;
      gap: 12px;
    }
    .side-col,
    .center-col {
      height: auto;
    }
    .plugin-grid__item {
      height: 280px;
    }
    .lightbox__btn--prev {
      left: var(--space-2);
    }
    .lightbox__btn--next {
      right: var(--space-2);
    }
    .lightbox__btn--close {
      top: var(--space-2);
      right: var(--space-2);
    }
  }
</style>

<script>
  const photos = [
    { id: 0, src: '/12 kolor.png', alt: 'Realizacja dźwięku filmowego na planie' },
    { id: 1, src: '/13 kolor.png', alt: 'Profesjonalny sprzęt nagraniowy Zaxcom' },
    { id: 2, src: '/14 kolor.png', alt: 'Praca lektorska i realizacja mikrofonowa' },
    { id: 3, src: '/15 kolor.png', alt: 'Sprzęt audio i torby realizatorskie Orca' },
    { id: 4, src: '/16 kolor.png', alt: 'Rejestrator dźwięku Nagra i odsłuchy' },
    { id: 5, src: '/17 kolor.png', alt: 'Praca na planie z ekipą filmową' },
    { id: 6, src: '/18 kolor.png', alt: 'Mikrofony kierunkowe i osłony przeciwwiatrowe' },
    { id: 7, src: '/19 kolor.png', alt: 'Portfolio nagrań plenerowych' },
    { id: 8, src: '/20 kolor.png', alt: 'Zestaw odbiorników bezprzewodowych Wisycom' },
  ];

  let currentIndex = 0;

  const modal = document.getElementById('lightbox-modal');
  const modalImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const modalCaption = document.getElementById('lightbox-caption');
  const modalCounter = document.getElementById('lightbox-counter');
  const backdrop = document.getElementById('lightbox-backdrop');
  const closeBtn = document.getElementById('lightbox-close');
  const prevBtn = document.getElementById('lightbox-prev');
  const nextBtn = document.getElementById('lightbox-next');

  function openLightbox(index: number) {
    currentIndex = index;
    updateLightbox();
    modal?.classList.add('lightbox--active');
    modal?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    modal?.classList.remove('lightbox--active');
    modal?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  function updateLightbox() {
    const photo = photos[currentIndex];
    if (modalImg && photo) {
      modalImg.src = photo.src;
      modalImg.alt = photo.alt;
    }
    if (modalCaption && photo) {
      modalCaption.textContent = photo.alt;
    }
    if (modalCounter) {
      modalCounter.textContent = `${currentIndex + 1} / ${photos.length}`;
    }
  }

  function showNext() {
    currentIndex = (currentIndex + 1) % photos.length;
    updateLightbox();
  }

  function showPrev() {
    currentIndex = (currentIndex - 1 + photos.length) % photos.length;
    updateLightbox();
  }

  // Event Listeners
  document.querySelectorAll('.plugin-grid__item').forEach((item) => {
    item.addEventListener('click', () => {
      const indexAttr = item.getAttribute('data-lightbox-index');
      if (indexAttr !== null) {
        openLightbox(parseInt(indexAttr, 10));
      }
    });
  });

  closeBtn?.addEventListener('click', closeLightbox);
  backdrop?.addEventListener('click', closeLightbox);
  prevBtn?.addEventListener('click', showPrev);
  nextBtn?.addEventListener('click', showNext);

  document.addEventListener('keydown', (e) => {
    if (!modal?.classList.contains('lightbox--active')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowRight') showNext();
    if (e.key === 'ArrowLeft') showPrev();
  });
</script>
