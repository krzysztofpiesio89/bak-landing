---
interface Props {
  variant?: 'first' | 'second';
}

const { variant = 'first' } = Astro.props;

const firstPairs = [
  { line1: 'Obraz wprowadza', line2: 'Dźwięk wciąga' },
  { line1: 'W reklamie liczy się', line2: 'Dobry dźwięk wyróżnia' },
];

const secondPairs = [
  { line1: 'To, czego nie widać w obrazie,', line2: 'często słychać w dźwięku' },
];

const selectedPairs = variant === 'first' ? firstPairs : secondPairs;
const doubled = [...selectedPairs, ...selectedPairs, ...selectedPairs, ...selectedPairs, ...selectedPairs];
---

<div class="marquee-section" aria-hidden="true">
  <div class="marquee-track">
    <div class="marquee-inner">
      {doubled.map((pair) => (
        <div class="marquee-group">
          <div class="marquee-line marquee-line--normal">{pair.line1}</div>
          <div class="marquee-line marquee-line--accent">{pair.line2}</div>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .marquee-section {
    position: relative;
    padding: var(--space-12) 0;
    overflow: hidden;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: #000000;
  }

  /* 1/3 Left and 3/3 Right Blur Overlay (3.6px Blur - Reduced by 40%) */
  .marquee-section::before,
  .marquee-section::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 33.33vw; /* Covers exact 1/3 left and 1/3 right */
    z-index: 2;
    pointer-events: none;
    background: transparent;
    backdrop-filter: blur(3.6px);
    -webkit-backdrop-filter: blur(3.6px);
  }

  .marquee-section::before {
    left: 0;
    mask-image: linear-gradient(to right, black 0%, black 50%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, black 0%, black 50%, transparent 100%);
  }

  .marquee-section::after {
    right: 0;
    mask-image: linear-gradient(to left, black 0%, black 50%, transparent 100%);
    -webkit-mask-image: linear-gradient(to left, black 0%, black 50%, transparent 100%);
  }

  .marquee-track {
    display: flex;
    overflow: hidden;
    width: 100%;
  }

  .marquee-inner {
    display: flex;
    align-items: center;
    gap: 120px;
    white-space: nowrap;
    animation: marquee 35s linear infinite;
    will-change: transform;
  }

  .marquee-inner:hover {
    animation-play-state: paused;
  }

  .marquee-group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    flex-shrink: 0;
  }

  .marquee-line {
    font-family: 'Neue Haas Grotesk Text Pro', 'Inter', sans-serif;
    font-size: clamp(2rem, 3.5vw, 48px);
    line-height: 120%;
    letter-spacing: -0.03em;
    white-space: nowrap;
    display: block;
  }

  .marquee-line--normal {
    font-weight: 500;
    color: #FDFDFD;
  }

  .marquee-line--accent {
    font-weight: 700;
    color: var(--color-accent);
  }

  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
