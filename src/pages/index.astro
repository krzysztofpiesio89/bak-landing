---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import Marquee from '../components/Marquee.astro';
import About from '../components/About.astro';
import Process from '../components/Process.astro';
import Services from '../components/Services.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Contact from '../components/Contact.astro';
---

<Layout
  title="Krzysztof Bąk — Realizator Dźwięku dla Filmów i Reklam"
  description="Profesjonalna postprodukcja dźwięku filmowego i reklamowego. Mix, sound design, nagrania terenowe. TVN, Polsat, PSE."
>
  <Navbar />
  <main id="main-content">
    <Hero />
    <PhotoGrid />
    <Marquee variant="first" />
    <About />
    <Process />
    <Marquee variant="second" />
    <Services />
    <BeforeAfter />
    <Contact />
  </main>
</Layout>
